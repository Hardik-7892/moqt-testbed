# LL-DASH Origin H2 (nginx) — HTTP/2 over TCP+TLS
# decisions.md D8: H2 = TCP HOL baseline vs MoQ QUIC
FROM nginx:alpine

RUN mkdir -p /data /usr/share/nginx/html /certs && \
    printf 'server {\n\
    listen 443 ssl http2;\n\
    ssl_certificate /certs/cert.pem;\n\
    ssl_certificate_key /certs/key.pem;\n\
    ssl_protocols TLSv1.2 TLSv1.3;\n\
    root /usr/share/nginx/html;\n\
    location / { autoindex on; add_header Cache-Control "no-cache"; try_files $uri $uri/ =404; }\n\
    location /data/ { alias /data/; }\n\
}\n\
server { listen 80; location / { return 301 https://$host:443$request_uri; } }\n' > /etc/nginx/conf.d/default.conf

RUN apk add --no-cache iproute2 openssl bash

EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
