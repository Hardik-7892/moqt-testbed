# LL-DASH Origin (generic) — backwards-compat alias for H2
# Aligned to decisions.md D2/D3/D8: 2s segment = 2s MoQ group, same sample_120s.mp4 source.
# This Dockerfile is kept as alias; real H2/H3 are Dockerfile.origin.h2 / h3.
FROM nginx:alpine
RUN mkdir -p /data /usr/share/nginx/html /certs && \
    printf 'server {\n listen 443 ssl http2; ssl_certificate /certs/cert.pem; ssl_certificate_key /certs/key.pem; ssl_protocols TLSv1.2 TLSv1.3; root /usr/share/nginx/html; location / { autoindex on; add_header Cache-Control "no-cache"; } }\n' > /etc/nginx/conf.d/default.conf
RUN apk add --no-cache iproute2 bash
EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
